# Site
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Preview without Supabase. Must be false in production.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — server only. Never expose this in the browser.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

# Quotas
MONTHLY_MESSAGE_QUOTA=200
RATE_LIMIT_PER_MINUTE=8
HISTORY_TOKEN_BUDGET=6000

# Payments. Default provider is stripe. See README to swap in Paddle or Lemon Squeezy.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_ID=price_your-monthly-price

# Comma-separated emails allowed to open /admin and flip memberships by hand.
ADMIN_EMAILS=owner@example.com
